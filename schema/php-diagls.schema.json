{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cristianradulescu/php-diagls/schema/php-diagls.schema.json",
  "title": "PHP Diagnostics LSP Server Configuration",
  "description": "Configuration schema for php-diagls LSP server",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "diagnosticsProviders": {
      "type": "object",
      "description": "Configuration for diagnostic providers",
      "properties": {
        "phpcsfixer": {
          "$ref": "#/$defs/phpCsFixerProvider"
        },
        "phpstan": {
          "$ref": "#/$defs/phpStanProvider"
        },
        "phplint": {
          "$ref": "#/$defs/phpLintProvider"
        },
        "mago": {
          "$ref": "#/$defs/magoProvider"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/diagnosticsProvider"
      },
      "minProperties": 1
    }
  },
  "required": ["diagnosticsProviders"],
  "additionalProperties": false,
  "$defs": {
    "diagnosticsProvider": {
      "type": "object",
      "description": "Base diagnostic provider configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable this diagnostic provider",
          "default": true
        },
        "container": {
          "type": "string",
          "description": "Name of the Docker container where the diagnostic tool is installed",
          "minLength": 1,
          "examples": ["my-php-container", "php-dev", "app-container"]
        },
        "path": {
          "type": "string",
          "description": "Full path to the diagnostic tool executable inside the container",
          "minLength": 1,
          "pattern": "^/.*",
          "examples": ["/usr/local/bin/php-cs-fixer", "/usr/bin/phpstan"]
        },
        "configFile": {
          "type": "string",
          "description": "Path to the diagnostic tool configuration file inside the container (relative to project root)",
          "examples": [
            ".php-cs-fixer.dist.php",
            "phpstan.neon",
            "phpstan.dist.neon"
          ]
        },
        "excludePaths": {
          "type": "array",
          "description": "Paths (relative to project root) to exclude from this provider's diagnostics/formatting. Supports directory names, exact relative paths, and glob patterns.",
          "items": {
            "type": "string"
          },
          "examples": [["tests"], ["var", "public"], ["src/Legacy/*"]]
        }
      },
      "required": ["enabled", "container", "path"],
      "additionalProperties": false
    },
    "formatConfig": {
      "type": "object",
      "description": "Formatting configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable document formatting using this provider",
          "default": false
        },
        "timeoutSeconds": {
          "type": "integer",
          "description": "Timeout in seconds for formatting operations (default: 30)",
          "minimum": 1,
          "maximum": 300,
          "default": 30
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "phpCsFixerProvider": {
      "type": "object",
      "description": "PHP CS Fixer diagnostic and formatting provider configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable PHP CS Fixer",
          "default": true
        },
        "container": {
          "type": "string",
          "description": "Name of the Docker container where PHP CS Fixer is installed",
          "minLength": 1,
          "examples": ["my-php-container", "php-dev", "app-container"]
        },
        "path": {
          "type": "string",
          "description": "Full path to php-cs-fixer executable inside the container",
          "minLength": 1,
          "pattern": "^/.*",
          "default": "/usr/local/bin/php-cs-fixer",
          "examples": [
            "/usr/local/bin/php-cs-fixer",
            "/usr/bin/php-cs-fixer",
            "/app/vendor/bin/php-cs-fixer"
          ]
        },
        "configFile": {
          "type": "string",
          "description": "Path to PHP CS Fixer configuration file (relative to project root)",
          "examples": [
            ".php-cs-fixer.dist.php",
            ".php-cs-fixer.php",
            "tools/php-cs-fixer.php"
          ]
        },
        "format": {
          "$ref": "#/$defs/formatConfig",
          "description": "Document formatting configuration for PHP CS Fixer"
        },
        "excludePaths": {
          "type": "array",
          "description": "Paths (relative to project root) to exclude from PHP CS Fixer diagnostics/formatting. Supports directory names, exact relative paths, and glob patterns. Note: php-cs-fixer's own Finder excludes are ignored when a file path is passed explicitly, so use this option to replicate them.",
          "items": {
            "type": "string"
          },
          "examples": [["tests"], ["var", "public"], ["src/Legacy/*"]]
        }
      },
      "required": ["enabled", "container", "path"],
      "additionalProperties": false
    },
    "phpStanProvider": {
      "type": "object",
      "description": "PHPStan static analysis provider configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable PHPStan",
          "default": false
        },
        "container": {
          "type": "string",
          "description": "Name of the Docker container where PHPStan is installed",
          "minLength": 1,
          "examples": ["my-php-container", "php-dev", "app-container"]
        },
        "path": {
          "type": "string",
          "description": "Full path to phpstan executable inside the container",
          "minLength": 1,
          "pattern": "^/.*",
          "default": "/usr/local/bin/phpstan",
          "examples": [
            "/usr/local/bin/phpstan",
            "/usr/bin/phpstan",
            "/app/vendor/bin/phpstan"
          ]
        },
        "configFile": {
          "type": "string",
          "description": "Path to PHPStan configuration file (relative to project root)",
          "examples": [
            "phpstan.neon",
            "phpstan.dist.neon",
            "phpstan.neon.dist",
            "tools/phpstan.neon"
          ]
        },
        "excludePaths": {
          "type": "array",
          "description": "Paths (relative to project root) to exclude from PHPStan diagnostics. Supports directory names, exact relative paths, and glob patterns.",
          "items": {
            "type": "string"
          },
          "examples": [["tests"], ["var", "public"], ["src/Legacy/*"]]
        }
      },
      "required": ["enabled", "container", "path"],
      "additionalProperties": false
    },
    "phpLintProvider": {
      "type": "object",
      "description": "PHP syntax check (php -l) provider configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable the php -l syntax check",
          "default": true
        },
        "container": {
          "type": "string",
          "description": "Name of the Docker container where the php binary is installed",
          "minLength": 1,
          "examples": ["my-php-container", "php-dev", "app-container"]
        },
        "path": {
          "type": "string",
          "description": "Full path to the php executable inside the container",
          "minLength": 1,
          "pattern": "^/.*",
          "default": "/usr/local/bin/php",
          "examples": ["/usr/local/bin/php", "/usr/bin/php"]
        },
        "excludePaths": {
          "type": "array",
          "description": "Paths (relative to project root) to exclude from the syntax check. Supports directory names, exact relative paths, and glob patterns.",
          "items": {
            "type": "string"
          },
          "examples": [["tests"], ["var", "public"], ["src/Legacy/*"]]
        }
      },
      "required": ["enabled", "container", "path"],
      "additionalProperties": false
    },
    "magoProvider": {
      "type": "object",
      "description": "Mago linter, static analyzer and formatter provider configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable Mago",
          "default": false
        },
        "container": {
          "type": "string",
          "description": "Name of the Docker container where Mago is installed",
          "minLength": 1,
          "examples": ["my-php-container", "php-dev", "app-container"]
        },
        "path": {
          "type": "string",
          "description": "Full path to the mago executable inside the container",
          "minLength": 1,
          "pattern": "^/.*",
          "default": "/usr/local/bin/mago",
          "examples": ["/usr/local/bin/mago", "/app/vendor/bin/mago"]
        },
        "configFile": {
          "type": "string",
          "description": "Path to the Mago configuration file (relative to project root). When omitted, Mago looks for mago.toml in the project root.",
          "examples": ["mago.toml", "tools/mago.toml"]
        },
        "commands": {
          "type": "array",
          "description": "Mago commands to run for diagnostics (default: both). Note: analyze only resolves classes/functions from other files when mago.toml lists them under [source] paths.",
          "items": {
            "type": "string",
            "enum": ["lint", "analyze"]
          },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["lint", "analyze"],
          "examples": [["lint"], ["lint", "analyze"]]
        },
        "format": {
          "$ref": "#/$defs/formatConfig",
          "description": "Document formatting configuration for Mago (mago format)"
        },
        "excludePaths": {
          "type": "array",
          "description": "Paths (relative to project root) to exclude from Mago diagnostics/formatting. Supports directory names, exact relative paths, and glob patterns.",
          "items": {
            "type": "string"
          },
          "examples": [["tests"], ["var", "public"], ["src/Legacy/*"]]
        }
      },
      "required": ["enabled", "container", "path"],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "diagnosticsProviders": {
        "phplint": {
          "enabled": true,
          "container": "my-php-container",
          "path": "/usr/local/bin/php"
        },
        "phpcsfixer": {
          "enabled": true,
          "container": "my-php-container",
          "path": "/usr/local/bin/php-cs-fixer",
          "configFile": ".php-cs-fixer.dist.php",
          "format": {
            "enabled": true
          }
        },
        "phpstan": {
          "enabled": false,
          "container": "my-php-container",
          "path": "/usr/local/bin/phpstan",
          "configFile": "phpstan.neon"
        },
        "mago": {
          "enabled": false,
          "container": "my-php-container",
          "path": "/usr/local/bin/mago",
          "configFile": "mago.toml",
          "commands": ["lint", "analyze"]
        }
      }
    },
    {
      "diagnosticsProviders": {
        "phpcsfixer": {
          "enabled": true,
          "container": "php-dev",
          "path": "/app/vendor/bin/php-cs-fixer",
          "configFile": ".php-cs-fixer.php",
          "format": {
            "enabled": true
          }
        }
      }
    }
  ]
}
